#!/bin/sh
# Blocks commits that contain secrets. Enabled via: npm run setup:hooks
# Bypass (only when you are certain it is a false positive): git commit --no-verify

fail=0

# 1. Block secret-bearing files by name, no matter what .gitignore says.
blocked=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.env($|\.)|(^|/)cookies\.txt$|\.(pem|key|p12|pfx)$' | grep -v '\.env\.example$')
if [ -n "$blocked" ]; then
  echo "BLOCKED: these files must never be committed:"
  echo "$blocked" | sed 's/^/  - /'
  fail=1
fi

# 2. Scan staged content for high-confidence secret patterns.
#    Placeholders (your_token_here, <...>, xxx, generate_with_...) are allowed.
matches=$(git diff --cached --diff-filter=ACM -U0 -- . ':!package-lock.json' ':!*.md' \
  | grep -E '^\+' | grep -v '^+++' \
  | grep -nEi \
      -e '[0-9]{8,10}:AA[A-Za-z0-9_-]{32,}' \
      -e '(SESSION_SECRET|DATABASE_URL|API_KEY|SECRET_KEY|ACCESS_TOKEN|PASSWORD)[[:space:]]*=[[:space:]]*["'"'"']?[A-Za-z0-9+/_-]{16,}' \
      -e 'postgres(ql)?://[^:]+:[^@[:space:]]{8,}@' \
      -e '\b(sk|pk)-[A-Za-z0-9]{20,}' \
      -e 'AKIA[0-9A-Z]{16}' \
  | grep -viE 'your_|_here|example|placeholder|xxxx|generate_with|process\.env|<[a-z_]+>|:password@|:pass@|changeme|get_from_|dummy|sample|redacted|\*\*\*')
if [ -n "$matches" ]; then
  echo "BLOCKED: staged changes look like they contain a live secret:"
  echo "$matches" | cut -c1-160 | sed 's/^/  /'
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Move the value into .env (git-ignored) and read it via process.env."
  exit 1
fi
exit 0
